{
  "name": "dps-store-garment",
  "version": "0.3.3",
  "description": "가먼트 프린터 출력 클라이언트",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron .",
    "build:win": "pnpm build && pnpm vendor && electron-builder --win",
    "release": "pnpm build && pnpm vendor && electron-builder --publish always",
    "lint": "tsc --noEmit",
    "vendor": "node scripts/restore-vendor.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  }
}
